<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ResourceCycle,NewApi">

    <!-- Independent album-art scale attributes. -->
    <attr name="Hugo_ItemTrackAAImage_scene_aa_scale" format="float" />
    <attr name="Hugo_ItemTrackAAImage_scene_aa_scale_playing" format="float" />

    <!-- Keep the stock Poweramp interface and override only the requested visual elements. -->
    <style name="HugoSkin" parent="com.maxmpz.audioplayer:style/Base_ActivityTheme_Default">
        <item name="com.maxmpz.audioplayer:ItemTrackAAImage_scene_aa">@style/Hugo_ItemTrackAAImage_scene_aa</item>
        <item name="com.maxmpz.audioplayer:ItemTrackAAImage_scene_aa_playing">@style/Hugo_ItemTrackAAImage_scene_aa_playing</item>
        <item name="Hugo_ItemTrackAAImage_scene_aa_scale">0.975</item>
        <item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">1.0</item>
        <item name="com.maxmpz.audioplayer:corners_aa_scene_aa">@+id/hugoCornersAA</item>
    </style>

    <style name="Hugo_ItemTrackAAImage_scene_aa" parent="com.maxmpz.audioplayer:ItemTrackAAImage_scene_aa">
        <item name="com.maxmpz.audioplayer:scale">?Hugo_ItemTrackAAImage_scene_aa_scale</item>
    </style>
    <style name="Hugo_ItemTrackAAImage_scene_aa_playing" parent="com.maxmpz.audioplayer:ItemTrackAAImage_scene_aa_playing">
        <item name="com.maxmpz.audioplayer:scale">?Hugo_ItemTrackAAImage_scene_aa_scale_playing</item>
    </style>

    <!-- Six coherent presets. Manual background/accent selectors below can override them. -->
    <style name="HugoPresetNightViolet">
        <item name="com.maxmpz.audioplayer:colorBgInverse">#120D1D</item>
        <item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item>
        <item name="com.maxmpz.audioplayer:colorIcon">#F5F0FF</item>
        <item name="com.maxmpz.audioplayer:colorAccent">#9B6CFF</item>
    </style>
    <style name="HugoPresetOledPurple">
        <item name="com.maxmpz.audioplayer:colorBgInverse">#000000</item>
        <item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item>
        <item name="com.maxmpz.audioplayer:colorIcon">#FFFFFF</item>
        <item name="com.maxmpz.audioplayer:colorAccent">#B06CFF</item>
    </style>
    <style name="HugoPresetDeepBlue">
        <item name="com.maxmpz.audioplayer:colorBgInverse">#0A1628</item>
        <item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item>
        <item name="com.maxmpz.audioplayer:colorIcon">#EEF6FF</item>
        <item name="com.maxmpz.audioplayer:colorAccent">#4DA3FF</item>
    </style>
    <style name="HugoPresetGraphiteOrange">
        <item name="com.maxmpz.audioplayer:colorBgInverse">#202124</item>
        <item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item>
        <item name="com.maxmpz.audioplayer:colorIcon">#F5F5F5</item>
        <item name="com.maxmpz.audioplayer:colorAccent">#FF8A3D</item>
    </style>
    <style name="HugoPresetForest">
        <item name="com.maxmpz.audioplayer:colorBgInverse">#102A24</item>
        <item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item>
        <item name="com.maxmpz.audioplayer:colorIcon">#F0FFF9</item>
        <item name="com.maxmpz.audioplayer:colorAccent">#5FE1B3</item>
    </style>
    <style name="HugoPresetLight">
        <item name="com.maxmpz.audioplayer:colorBgInverse">#F5F3F8</item>
        <item name="com.maxmpz.audioplayer:colorFgInverse">#17151B</item>
        <item name="com.maxmpz.audioplayer:colorIcon">#242027</item>
        <item name="com.maxmpz.audioplayer:colorAccent">#7651D6</item>
    </style>

    <!-- Background palette. -->
    <style name="HugoBgBlack"><item name="com.maxmpz.audioplayer:colorBgInverse">#000000</item><item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorIcon">#FFFFFF</item></style>
    <style name="HugoBgCharcoal"><item name="com.maxmpz.audioplayer:colorBgInverse">#121212</item><item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorIcon">#FFFFFF</item></style>
    <style name="HugoBgGraphite"><item name="com.maxmpz.audioplayer:colorBgInverse">#202124</item><item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorIcon">#F5F5F5</item></style>
    <style name="HugoBgSlate"><item name="com.maxmpz.audioplayer:colorBgInverse">#263238</item><item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorIcon">#F7FBFC</item></style>
    <style name="HugoBgNavy"><item name="com.maxmpz.audioplayer:colorBgInverse">#0B132B</item><item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorIcon">#F2F5FF</item></style>
    <style name="HugoBgDeepBlue"><item name="com.maxmpz.audioplayer:colorBgInverse">#0A2342</item><item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorIcon">#F2F7FF</item></style>
    <style name="HugoBgViolet"><item name="com.maxmpz.audioplayer:colorBgInverse">#261447</item><item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorIcon">#F7F1FF</item></style>
    <style name="HugoBgPurple"><item name="com.maxmpz.audioplayer:colorBgInverse">#3B145F</item><item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorIcon">#FAF3FF</item></style>
    <style name="HugoBgBurgundy"><item name="com.maxmpz.audioplayer:colorBgInverse">#4A1628</item><item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorIcon">#FFF4F7</item></style>
    <style name="HugoBgBrown"><item name="com.maxmpz.audioplayer:colorBgInverse">#3E2723</item><item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorIcon">#FFF7F2</item></style>
    <style name="HugoBgForest"><item name="com.maxmpz.audioplayer:colorBgInverse">#123524</item><item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorIcon">#F1FFF7</item></style>
    <style name="HugoBgOlive"><item name="com.maxmpz.audioplayer:colorBgInverse">#344322</item><item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorIcon">#FAFFF2</item></style>
    <style name="HugoBgWarmGray"><item name="com.maxmpz.audioplayer:colorBgInverse">#5B5652</item><item name="com.maxmpz.audioplayer:colorFgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorIcon">#FFFFFF</item></style>
    <style name="HugoBgLightGray"><item name="com.maxmpz.audioplayer:colorBgInverse">#ECEFF1</item><item name="com.maxmpz.audioplayer:colorFgInverse">#17191A</item><item name="com.maxmpz.audioplayer:colorIcon">#202326</item></style>
    <style name="HugoBgCream"><item name="com.maxmpz.audioplayer:colorBgInverse">#FFF4E5</item><item name="com.maxmpz.audioplayer:colorFgInverse">#211A12</item><item name="com.maxmpz.audioplayer:colorIcon">#2A2117</item></style>
    <style name="HugoBgWhite"><item name="com.maxmpz.audioplayer:colorBgInverse">#FFFFFF</item><item name="com.maxmpz.audioplayer:colorFgInverse">#151515</item><item name="com.maxmpz.audioplayer:colorIcon">#202020</item></style>

    <!-- Accent palette. -->
    <style name="HugoAccentOrange"><item name="com.maxmpz.audioplayer:colorAccent">#FF8A3D</item></style>
    <style name="HugoAccentAmber"><item name="com.maxmpz.audioplayer:colorAccent">#FFC247</item></style>
    <style name="HugoAccentRed"><item name="com.maxmpz.audioplayer:colorAccent">#FF5A5F</item></style>
    <style name="HugoAccentPink"><item name="com.maxmpz.audioplayer:colorAccent">#FF5FA2</item></style>
    <style name="HugoAccentPurple"><item name="com.maxmpz.audioplayer:colorAccent">#9B6CFF</item></style>
    <style name="HugoAccentBlue"><item name="com.maxmpz.audioplayer:colorAccent">#4DA3FF</item></style>
    <style name="HugoAccentCyan"><item name="com.maxmpz.audioplayer:colorAccent">#45D6E8</item></style>
    <style name="HugoAccentTeal"><item name="com.maxmpz.audioplayer:colorAccent">#4DD6AE</item></style>
    <style name="HugoAccentGreen"><item name="com.maxmpz.audioplayer:colorAccent">#65D36E</item></style>
    <style name="HugoAccentLime"><item name="com.maxmpz.audioplayer:colorAccent">#A7DC58</item></style>
    <style name="HugoAccentWhite"><item name="com.maxmpz.audioplayer:colorAccent">#FFFFFF</item></style>

    <!-- Main cover sizes. Paused value is kept slightly smaller to retain Poweramp's native animation. -->
    <style name="HugoAAScale075"><item name="Hugo_ItemTrackAAImage_scene_aa_scale">0.73</item><item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">0.75</item></style>
    <style name="HugoAAScale085"><item name="Hugo_ItemTrackAAImage_scene_aa_scale">0.82</item><item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">0.85</item></style>
    <style name="HugoAAScale095"><item name="Hugo_ItemTrackAAImage_scene_aa_scale">0.92</item><item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">0.95</item></style>
    <style name="HugoAAScale100"><item name="Hugo_ItemTrackAAImage_scene_aa_scale">0.975</item><item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">1.0</item></style>
    <style name="HugoAAScale110"><item name="Hugo_ItemTrackAAImage_scene_aa_scale">1.07</item><item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">1.10</item></style>
    <style name="HugoAAScale125"><item name="Hugo_ItemTrackAAImage_scene_aa_scale">1.22</item><item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">1.25</item></style>

    <!-- Optional cover shadow. Standard Android elevation is applied only to the main cover views. -->
    <style name="HugoShadowOn">
        <item name="com.maxmpz.audioplayer:ItemTrackAAImage_scene_aa">@style/Hugo_ItemTrackAAImage_scene_aa_Shadow</item>
        <item name="com.maxmpz.audioplayer:ItemTrackAAImage_scene_aa_playing">@style/Hugo_ItemTrackAAImage_scene_aa_playing_Shadow</item>
    </style>
    <style name="Hugo_ItemTrackAAImage_scene_aa_Shadow" parent="@style/Hugo_ItemTrackAAImage_scene_aa">
        <item name="android:elevation">10dp</item>
        <item name="android:translationZ">2dp</item>
    </style>
    <style name="Hugo_ItemTrackAAImage_scene_aa_playing_Shadow" parent="@style/Hugo_ItemTrackAAImage_scene_aa_playing">
        <item name="android:elevation">10dp</item>
        <item name="android:translationZ">2dp</item>
    </style>
</resources>
