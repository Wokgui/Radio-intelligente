<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="ResourceCycle,NewApi">

    <attr name="Hugo_ItemTrackAAImage_scene_aa_scale" format="float" />
    <attr name="Hugo_ItemTrackAAImage_scene_aa_scale_playing" format="float" />
    <attr name="Hugo_PlayerBgColor" format="color" />

    <!--
      V1.3: Poweramp's official TopMilk style has its own bgColor fixed to black.
      colorBgInverse alone therefore changes secondary surfaces but not the real
      playback canvas. We replace TopMilk and feed both bgColor and aaBgColor
      from the skin-selectable Hugo_PlayerBgColor attribute.
    -->
    <style name="HugoSkin" parent="com.maxmpz.audioplayer:style/ActivityTheme_Black">
        <item name="Hugo_PlayerBgColor">#120D1D</item>
        <item name="com.maxmpz.audioplayer:colorBgInverse">?Hugo_PlayerBgColor</item>
        <item name="com.maxmpz.audioplayer:colorAABgColor">?Hugo_PlayerBgColor</item>
        <item name="com.maxmpz.audioplayer:colorAccent">#9B6CFF</item>
        <item name="com.maxmpz.audioplayer:TopMilk">@style/Hugo_TopMilk</item>
        <item name="com.maxmpz.audioplayer:ItemTrackAAImage_scene_aa">@style/Hugo_ItemTrackAAImage_scene_aa</item>
        <item name="com.maxmpz.audioplayer:ItemTrackAAImage_scene_aa_playing">@style/Hugo_ItemTrackAAImage_scene_aa_playing</item>
        <item name="Hugo_ItemTrackAAImage_scene_aa_scale">0.975</item>
        <item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">1.0</item>
        <item name="com.maxmpz.audioplayer:corners_aa_scene_aa">@+id/hugoCornersAA</item>
    </style>

    <style name="Hugo_TopMilk" parent="com.maxmpz.audioplayer:TopMilk">
        <item name="com.maxmpz.audioplayer:bgColor">?Hugo_PlayerBgColor</item>
        <item name="com.maxmpz.audioplayer:aaBgColor">?Hugo_PlayerBgColor</item>
    </style>

    <style name="Hugo_ItemTrackAAImage_scene_aa" parent="com.maxmpz.audioplayer:ItemTrackAAImage_scene_aa">
        <item name="com.maxmpz.audioplayer:scale">?Hugo_ItemTrackAAImage_scene_aa_scale</item>
    </style>
    <style name="Hugo_ItemTrackAAImage_scene_aa_playing" parent="com.maxmpz.audioplayer:ItemTrackAAImage_scene_aa_playing">
        <item name="com.maxmpz.audioplayer:scale">?Hugo_ItemTrackAAImage_scene_aa_scale_playing</item>
    </style>

    <!-- Presets: background + accent. -->
    <style name="HugoPresetNightViolet">
        <item name="Hugo_PlayerBgColor">#120D1D</item>
        <item name="com.maxmpz.audioplayer:colorBgInverse">#120D1D</item>
        <item name="com.maxmpz.audioplayer:colorAABgColor">#120D1D</item>
        <item name="com.maxmpz.audioplayer:colorAccent">#9B6CFF</item>
    </style>
    <style name="HugoPresetOledPurple">
        <item name="Hugo_PlayerBgColor">#000000</item>
        <item name="com.maxmpz.audioplayer:colorBgInverse">#000000</item>
        <item name="com.maxmpz.audioplayer:colorAABgColor">#000000</item>
        <item name="com.maxmpz.audioplayer:colorAccent">#B06CFF</item>
    </style>
    <style name="HugoPresetDeepBlue">
        <item name="Hugo_PlayerBgColor">#0A1628</item>
        <item name="com.maxmpz.audioplayer:colorBgInverse">#0A1628</item>
        <item name="com.maxmpz.audioplayer:colorAABgColor">#0A1628</item>
        <item name="com.maxmpz.audioplayer:colorAccent">#4DA3FF</item>
    </style>
    <style name="HugoPresetGraphiteOrange">
        <item name="Hugo_PlayerBgColor">#202124</item>
        <item name="com.maxmpz.audioplayer:colorBgInverse">#202124</item>
        <item name="com.maxmpz.audioplayer:colorAABgColor">#202124</item>
        <item name="com.maxmpz.audioplayer:colorAccent">#FF8A3D</item>
    </style>
    <style name="HugoPresetForest">
        <item name="Hugo_PlayerBgColor">#102A24</item>
        <item name="com.maxmpz.audioplayer:colorBgInverse">#102A24</item>
        <item name="com.maxmpz.audioplayer:colorAABgColor">#102A24</item>
        <item name="com.maxmpz.audioplayer:colorAccent">#5FE1B3</item>
    </style>

    <!-- Background palette. These now drive the real playback canvas too. -->
    <style name="HugoBgBlack"><item name="Hugo_PlayerBgColor">#000000</item><item name="com.maxmpz.audioplayer:colorBgInverse">#000000</item><item name="com.maxmpz.audioplayer:colorAABgColor">#000000</item></style>
    <style name="HugoBgCharcoal"><item name="Hugo_PlayerBgColor">#121212</item><item name="com.maxmpz.audioplayer:colorBgInverse">#121212</item><item name="com.maxmpz.audioplayer:colorAABgColor">#121212</item></style>
    <style name="HugoBgGraphite"><item name="Hugo_PlayerBgColor">#202124</item><item name="com.maxmpz.audioplayer:colorBgInverse">#202124</item><item name="com.maxmpz.audioplayer:colorAABgColor">#202124</item></style>
    <style name="HugoBgSlate"><item name="Hugo_PlayerBgColor">#263238</item><item name="com.maxmpz.audioplayer:colorBgInverse">#263238</item><item name="com.maxmpz.audioplayer:colorAABgColor">#263238</item></style>
    <style name="HugoBgNavy"><item name="Hugo_PlayerBgColor">#0B132B</item><item name="com.maxmpz.audioplayer:colorBgInverse">#0B132B</item><item name="com.maxmpz.audioplayer:colorAABgColor">#0B132B</item></style>
    <style name="HugoBgDeepBlue"><item name="Hugo_PlayerBgColor">#0A2342</item><item name="com.maxmpz.audioplayer:colorBgInverse">#0A2342</item><item name="com.maxmpz.audioplayer:colorAABgColor">#0A2342</item></style>
    <style name="HugoBgViolet"><item name="Hugo_PlayerBgColor">#261447</item><item name="com.maxmpz.audioplayer:colorBgInverse">#261447</item><item name="com.maxmpz.audioplayer:colorAABgColor">#261447</item></style>
    <style name="HugoBgPurple"><item name="Hugo_PlayerBgColor">#3B145F</item><item name="com.maxmpz.audioplayer:colorBgInverse">#3B145F</item><item name="com.maxmpz.audioplayer:colorAABgColor">#3B145F</item></style>
    <style name="HugoBgBurgundy"><item name="Hugo_PlayerBgColor">#4A1628</item><item name="com.maxmpz.audioplayer:colorBgInverse">#4A1628</item><item name="com.maxmpz.audioplayer:colorAABgColor">#4A1628</item></style>
    <style name="HugoBgBrown"><item name="Hugo_PlayerBgColor">#3E2723</item><item name="com.maxmpz.audioplayer:colorBgInverse">#3E2723</item><item name="com.maxmpz.audioplayer:colorAABgColor">#3E2723</item></style>
    <style name="HugoBgForest"><item name="Hugo_PlayerBgColor">#123524</item><item name="com.maxmpz.audioplayer:colorBgInverse">#123524</item><item name="com.maxmpz.audioplayer:colorAABgColor">#123524</item></style>
    <style name="HugoBgOlive"><item name="Hugo_PlayerBgColor">#344322</item><item name="com.maxmpz.audioplayer:colorBgInverse">#344322</item><item name="com.maxmpz.audioplayer:colorAABgColor">#344322</item></style>
    <style name="HugoBgWarmGray"><item name="Hugo_PlayerBgColor">#5B5652</item><item name="com.maxmpz.audioplayer:colorBgInverse">#5B5652</item><item name="com.maxmpz.audioplayer:colorAABgColor">#5B5652</item></style>

    <!-- Accent palette. -->
    <style name="HugoAccentOrange"><item name="com.maxmpz.audioplayer:colorAccent">#FF8A3D</item></style>
    <style name="HugoAccentAmber"><item name="com.maxmpz.audioplayer:colorAccent">#FFC247</item></style>
    <style name="HugoAccentRed"><item name="com.maxmpz.audioplayer:colorAccent">#FF5A5F</item></style>
    <style name="HugoAccentPink"><item name="com.maxmpz.audioplayer:colorAccent">#FF5FA2</item></style>
    <style name="HugoAccentPurple"><item name="com.maxmpz.audioplayer:colorAccent">#9B6CFF</item></style>
    <style name="HugoAccentBlue"><item name="com.maxmpz.audioplayer:colorAccent">#4DA3FF</item></style>
    <style name="HugoAccentCyan"><item name="com.maxmpz.audioplayer:colorAccent">#45D6E8</item></style>
    <style name="HugoAccentTeal"><item name="com.maxmpz.audioplayer:colorAccent">#4DD6AE</item></style>
    <style name="HugoAccentGreen"><item name="com.maxmpz.audioplayer:colorAccent">#65D36E</item></style>
    <style name="HugoAccentLime"><item name="com.maxmpz.audioplayer:colorAccent">#A7DC58</item></style>
    <style name="HugoAccentWhite"><item name="com.maxmpz.audioplayer:colorAccent">#FFFFFF</item></style>

    <!-- Main cover sizes. -->
    <style name="HugoAAScale075"><item name="Hugo_ItemTrackAAImage_scene_aa_scale">0.73</item><item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">0.75</item></style>
    <style name="HugoAAScale085"><item name="Hugo_ItemTrackAAImage_scene_aa_scale">0.82</item><item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">0.85</item></style>
    <style name="HugoAAScale095"><item name="Hugo_ItemTrackAAImage_scene_aa_scale">0.92</item><item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">0.95</item></style>
    <style name="HugoAAScale100"><item name="Hugo_ItemTrackAAImage_scene_aa_scale">0.975</item><item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">1.0</item></style>
    <style name="HugoAAScale110"><item name="Hugo_ItemTrackAAImage_scene_aa_scale">1.07</item><item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">1.10</item></style>
    <style name="HugoAAScale125"><item name="Hugo_ItemTrackAAImage_scene_aa_scale">1.22</item><item name="Hugo_ItemTrackAAImage_scene_aa_scale_playing">1.25</item></style>

    <!-- Optional cover shadow. -->
    <style name="HugoShadowOn">
        <item name="com.maxmpz.audioplayer:ItemTrackAAImage_scene_aa">@style/Hugo_ItemTrackAAImage_scene_aa_Shadow</item>
        <item name="com.maxmpz.audioplayer:ItemTrackAAImage_scene_aa_playing">@style/Hugo_ItemTrackAAImage_scene_aa_playing_Shadow</item>
    </style>
    <style name="Hugo_ItemTrackAAImage_scene_aa_Shadow" parent="@style/Hugo_ItemTrackAAImage_scene_aa">
        <item name="android:elevation">10dp</item>
        <item name="android:translationZ">2dp</item>
    </style>
    <style name="Hugo_ItemTrackAAImage_scene_aa_playing_Shadow" parent="@style/Hugo_ItemTrackAAImage_scene_aa_playing">
        <item name="android:elevation">10dp</item>
        <item name="android:translationZ">2dp</item>
    </style>
</resources>
