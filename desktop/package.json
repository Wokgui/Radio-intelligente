{
  "name": "app-interface-studio",
  "version": "6.17.0",
  "private": true,
  "description": "Éditeur visuel universel Windows avec ancrages directs autour de la sélection, lignes de contraintes vers le parent, espacements égaux, redimensionnement de groupe et palette clavier",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check ../visual-editor.js && node scripts/check-responsive.cjs",
    "dist:win": "npm run icon && electron-builder --win portable",
    "icon": "node scripts/make-icon.cjs"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "sharp": "0.33.5",
    "png-to-ico": "2.1.8"
  },
  "build": {
    "appId": "fr.wokgui.appinterfacestudio",
    "productName": "App Interface Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "webapp",
        "filter": [
          "app-runtime.html",
          "index.html",
          "visual-editor.html",
          "visual-editor.js",
          "visual-editor.css",
          "visual-elements.js",
          "visual-elements.json",
          "radio-v51.css",
          "radio-v51.js",
          "radio-v51-core.js",
          "music-player.css",
          "music-player.js",
          "cloud-backup.js",
          "manifest.webmanifest",
          "cover-default.png",
          "icon-192.png",
          "icon-512.png",
          "icon-maskable-192.png",
          "apple-touch-icon.png",
          "favicon-32.png",
          "silence.wav",
          "vendor/**/*"
        ]
      },
      {
        "from": "build/icon-512.png",
        "to": "app-interface-studio-icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "artifactName": "App-Interface-Studio-${version}-portable-${arch}.${ext}"
  }
}
